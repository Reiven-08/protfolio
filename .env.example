# Server-only Resend credentials. Copy this file to .env locally and add your real key there.
RESEND_API_KEY=re_your_resend_api_key

# Optional: replace onboarding@resend.dev after verifying a domain in Resend.
RESEND_FROM_EMAIL="Reiven Portfolio <onboarding@resend.dev>"

# Server-only credentials for the private Edit Mode. Use a long random value for the session secret.
EDIT_ADMIN_USERNAME=your_admin_username
EDIT_ADMIN_PASSWORD=your_admin_password
EDIT_SESSION_SECRET=replace_with_a_long_random_secret
